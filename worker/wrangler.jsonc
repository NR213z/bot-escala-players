{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bot-escala-players-cron",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "triggers": {
    "crons": ["0 13 * * *", "0 21 * * *", "*/15 * * * *"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_BUFFER", "class_name": "ChatBuffer" },
      { "name": "ALERT_GATE", "class_name": "AlertGate" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatBuffer"] },
    { "tag": "v2", "new_sqlite_classes": ["AlertGate"] }
  ]
}
